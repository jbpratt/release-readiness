{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "Disable indirect Go dependency updates",
      "matchDepTypes": ["indirect"],
      "enabled": false
    },
    {
      "description": "Group vite and @vitejs/plugin-react updates",
      "groupName": "vite",
      "matchPackageNames": ["vite", "@vitejs/plugin-react"]
    }
  ]
}
